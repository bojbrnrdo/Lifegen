{
  "name": "lifegen-neon",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "LIFEGEN website with an integrated Lifegroup Tracker Admin portal and Supabase PostgreSQL",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "supabase:bundle": "node scripts/bundle-supabase.mjs",
    "db:backup": "node scripts/backup.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:lifegroup-integration": "node tests/lifegroup-integration.mjs",
    "package:vercel": "node scripts/package-vercel.mjs",
    "test:vip-design-integration": "node tests/vip-design-integration.mjs",
    "test:vip-gift-integration": "node tests/vip-gift-integration.mjs",
    "assets:version": "node scripts/version-assets.mjs"
  },
  "dependencies": {
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "fflate": "0.8.3",
    "helmet": "8.1.0",
    "pg": "8.20.0",
    "qrcode": "1.5.4"
  }
}
