{
  "name": "lifegen-neon",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "LIFEGEN website with an integrated Lifegroup Tracker Admin portal and Supabase PostgreSQL",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "npm run build:lifegroups && npm run build:carousel && npm run build:lifeide && node scripts/check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "supabase:bundle": "node scripts/bundle-supabase.mjs",
    "db:backup": "node scripts/backup.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:lifegroup-integration": "node tests/lifegroup-integration.mjs",
    "package:vercel": "node scripts/package-vercel.mjs",
    "test:vip-design-integration": "node tests/vip-design-integration.mjs",
    "test:vip-gift-integration": "node tests/vip-gift-integration.mjs",
    "test:community-integration": "node tests/community-board-integration.mjs",
    "assets:version": "node scripts/version-assets.mjs",
    "video:add": "node scripts/add-video.mjs",
    "test:lifeide-browser": "node tests/lifeide-browser-smoke.mjs",
    "build:lifegroups": "esbuild frontend/lifegroups/Map.jsx --bundle --format=esm --jsx=automatic --minify --outfile=public/admin/react-lifegroups.js --loader:.css=css",
    "build:carousel": "esbuild frontend/depth-carousel/index.jsx --bundle --format=iife --jsx=automatic --minify --outfile=public/lifegen/depth-carousel.js",
    "dev:local": "node scripts/start-local-demo.mjs",
    "build:lifeide": "esbuild frontend/lifeide/codemirror.js --bundle --format=iife --minify --outfile=public/lifeide/codemirror.bundle.js"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "fflate": "0.8.3",
    "helmet": "8.1.0",
    "pg": "8.20.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@xyflow/react": "^12.12.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.25.12",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
