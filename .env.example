# LIFEGEN private server settings — copy the names into a Git-ignored `.env` file.
# These values are read by the Node server only; the browser never receives them.
# Never commit a filled-in copy and never paste real connection strings into chat, Git,
# a public ZIP or browser JavaScript.

# Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL: the pooler URL used by normal application requests (transaction pooler or
# session pooler). Use the pooler host on Vercel, which is IPv4-reachable.
DATABASE_URL=
# DATABASE_DIRECT_URL: the direct db.<project-ref>.supabase.co URL when this machine can
# reach it, otherwise the Supabase Session Pooler URL on port 5432 (never port 6543).
# Required for migrations and PostgreSQL LISTEN updates.
DATABASE_DIRECT_URL=

# Optional. Supabase project CA certificate in PEM form, needed only when the server
# reports "self-signed certificate in certificate chain" for the Supabase database host.
# Copy it from Supabase: Project Settings → Database → SSL configuration → download the
# certificate, then keep the BEGIN/END CERTIFICATE lines. A single line with \n escapes
# is accepted as well. Certificate verification stays enabled either way; this variable
# adds the project CA to the system root certificates and never disables verification.
#DATABASE_SSL_ROOT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional: an extra PEM bundle for another private CA (honoured in addition to the system
# roots, as Node does; LIFEGEN keeps it working even while it uses its own trust store).
#NODE_EXTRA_CA_CERTS=/path/to/extra-ca.pem

# Temporary private code (32+ random characters) that creates the first Admin account.
# Remove it from the host and redeploy after that account exists.
SETUP_KEY=

# Keep false for a real Supabase deployment; `true` is only for the disposable local demo.
LOCAL_DEMO=false
